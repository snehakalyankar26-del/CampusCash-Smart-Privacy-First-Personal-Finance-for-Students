{
  "name": "campus-cash",
  "version": "1.0.0",
  "description": "Smart, privacy-first personal finance and daily planner web app for college students",
  "main": "src/server/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "node --watch src/server/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "keywords": [
    "student",
    "finance",
    "budget",
    "expense-tracker",
    "scholarships",
    "savings",
    "offline-first"
  ],
  "author": "Google DeepMind Engineer",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
